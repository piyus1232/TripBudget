# Copy to `.env` in this folder. Never commit `.env`.
# `index.js` loads `.env` first, then `./env` (legacy) for any keys not set.

# Server
PORT=5000

# MongoDB (no trailing slash on cluster URL; DB name appended in code)
MONGODB_URI=mongodb://127.0.0.1:27017

# CORS — frontend origin(s), comma-separated for multiple
# Examples: http://localhost:5173  or  https://app.example.com,https://www.example.com
CORS_ORIGIN=http://localhost:5173

# JWT (use long random strings in production)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# Email (nodemailer — see src/utils/sendemail.js)
HOST=
SERVICE=
EMAIL_PORT=587
SECURE=false
USER=
PASS=

# Cloudinary (optional profile uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Third-party APIs
# RapidAPI — google-map-places.p.rapidapi.com (geocode, directions proxy, nearby on RapidAPI)
GOOGLE_PLACES_RAPIDAPI_KEY=
# Optional fallbacks if GOOGLE_PLACES_RAPIDAPI_KEY is empty (same RapidAPI subscription key often works)
RAPIDAPI_PLACES_KEY=
RAPIDAPI_KEY=
UNSPLASH_ACCESS_KEY=
GEOAPIFY_API_KEY=
# Official Google Maps Places API (maps.googleapis.com nearby search — not RapidAPI)
GOOGLE_API_KEY=

# When hotel+place lat/lng are sent, use OSRM road route first (avoids RapidAPI Directions 429 quota).
# Set to 0 to always try Google Directions via RapidAPI first (transit/driving/walking).
TRANSPORT_SKIP_RAPID_WHEN_COORDS=1

# Train + hotels + places TTL (seconds). Default 604800 = 7 days.
TRAIN_CACHE_TTL_SEC=604800
PLAN_CACHE_TTL_SEC=604800
# 1 = save cache to Backend/.cache/plan-cache.json
PLAN_CACHE_DISK=1
# 1 = full plan also in MongoDB (recommended prod)
PLAN_CACHE_MONGO=1
# Only when train+hotels+places all cache hit: min wait (ms) before respond. 0 = off (recommended for demos)
MIN_PLAN_RESPONSE_MS=0
# Set to 1 to write debug_*.html during Puppeteer fare scrape (default off)
DEBUG_SCRAPE=
# Optional: path to Chrome/Chromium for Puppeteer (Linux server or custom install)
# CHROME_PATH=/usr/bin/google-chrome-stable
# Hotel USD→INR (must match frontend src/config/currency.js default)
USD_TO_INR_RATE=87.58
