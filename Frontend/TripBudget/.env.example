# Copy to `.env` in this folder. Vite only exposes variables prefixed with VITE_.

# Required in production: your API origin (no trailing slash)
# Examples:
#   VITE_API_BASE_URL=http://localhost:5000
#   VITE_API_BASE_URL=https://api.tripbudget.in
VITE_API_BASE_URL=http://localhost:5000

# Optional: Unsplash for city/hotel hero images on plan/saved views (https://unsplash.com/oauth/applications)
# Use the application's "Access Key" (Client ID). A "Secret" key will return 401.
# Leave empty to use a built-in landscape fallback image (no API calls).
VITE_UNSPLASH_ACCESS_KEY=
